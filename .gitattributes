*.mkv  binary
*.mov  binary
*.wav  binary
*.mp3  binary
*.m4a  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.7z   binary
*.gz   binary
*.pdf  binary
*.exe  binary
*.dll  binary
*.pyd  binary
*.so   binary
*.bin  binary
*.safetensors binary
*.pt   binary
