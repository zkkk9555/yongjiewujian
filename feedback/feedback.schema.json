{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Naraka Highlight Studio feedback",
  "type": "object",
  "required": ["request", "status"],
  "properties": {
    "time": {"type": "string"},
    "source_time": {"type": "number", "minimum": 0},
    "kind": {
      "type": "string",
      "enum": ["selection", "pacing", "music", "audio", "effects", "text", "quality", "other"]
    },
    "request": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "status": {"type": "string", "enum": ["new", "accepted", "rejected", "one_off"]}
  },
  "additionalProperties": true
}
